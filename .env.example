# =============================================================================
# Master Environment Variables Reference
# E-Commerce Platform — Microservices Architecture
# =============================================================================
# Copy this file and fill in your values.
# Each service also has its own .env.example with only the vars it needs.
# =============================================================================

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────
# Get this from: Atlas Dashboard → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net

# ─── JWT ────────────────────────────────────────────────────────────────────
# Use a long random string (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here

# ─── Admin Credentials ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=Admin@SecurePassword123

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
# For Docker Compose: uses service name 'rabbitmq' as hostname
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Full URL used by services (auto-constructed in docker-compose.yml)
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ─── AWS (S3 + SES) ─────────────────────────────────────────────────────────
# IAM user must have: AmazonS3FullAccess, AmazonSESFullAccess
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 — Product image storage
AWS_S3_BUCKET=your-ecommerce-bucket-name

# SES — Email sender (must be verified in AWS SES)
AWS_SES_FROM_EMAIL=noreply@yourstore.com

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Get from: stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_51...

# ─── Razorpay ───────────────────────────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=ShopSphere
FRONTEND_URL=https://yourstore.com

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (for gateway)
CORS_ORIGINS=https://yourstore.com,https://admin.yourstore.com

# ─── Docker Hub (for CI/CD) ─────────────────────────────────────────────────
# Set these as GitHub Secrets, not in .env
# DOCKER_USERNAME=yourdockerhubusername
# DOCKER_PASSWORD=yourdockerhubtoken

# ─── EC2 Deployment (GitHub Secrets) ────────────────────────────────────────
# Set these as GitHub Secrets, not in .env
# EC2_HOST=your-ec2-ip-or-domain
# EC2_USER=ubuntu
# EC2_SSH_KEY=-----BEGIN RSA PRIVATE KEY-----...
# EC2_APP_DIR=/home/ubuntu/ecommerce-app
