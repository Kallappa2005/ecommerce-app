# Product Service Environment Variables
# Copy this file to .env and fill in your actual values

PORT=4002
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://...

# Admin credentials (used for signing/verifying admin JWT tokens)
ADMIN_EMAIL=admin@forever.com
ADMIN_PASSWORD=admin@123

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_here

# AWS S3 configuration for product image uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=your-bucket

# RabbitMQ (not used by product-service currently, kept for future use)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
